{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QFF 2026 S3 Official Challenge Kit Manifest",
  "type": "object",
  "required": [
    "kit_version",
    "source_files",
    "s3_instance",
    "processor_A",
    "processor_B",
    "required_outputs"
  ],
  "properties": {
    "kit_version": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "s3_instance": {
      "type": "string",
      "minLength": 1
    },
    "processor_A": {
      "type": "string",
      "minLength": 1
    },
    "processor_B": {
      "type": "string",
      "minLength": 1
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
